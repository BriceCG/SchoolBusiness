<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_timetable_slot_calendar" model="ir.ui.view">
        <field name="name">school.timetable.slot.calendar</field>
        <field name="model">school.timetable.slot</field>
        <field name="arch" type="xml">
            <calendar string="Timetable" js_class="school_timetable_calendar" date_start="start_datetime" date_stop="stop_datetime"
                      color="subject_id" mode="week" scales="week" quick_create="0"
                      event_open_popup="1">
                <field name="level_id"/>
                <field name="classroom_id"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="room"/>
            </calendar>
        </field>
    </record>

    <record id="view_school_timetable_slot_list" model="ir.ui.view">
        <field name="name">school.timetable.slot.list</field>
        <field name="model">school.timetable.slot</field>
        <field name="arch" type="xml">
            <list string="Timetable">
                <field name="level_id"/>
                <field name="classroom_id"/>
                <field name="weekday"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="subject_id"/>
                <field name="teacher_id"/>
                <field name="room" optional="show"/>
                <field name="school_year_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_timetable_slot_form" model="ir.ui.view">
        <field name="name">school.timetable.slot.form</field>
        <field name="model">school.timetable.slot</field>
        <field name="arch" type="xml">
            <form string="Timetable Slot">
                <sheet>
                    <group>
                        <group>
                            <field name="level_id" options="{'no_create': True}"/>
                            <field name="classroom_id" options="{'no_create': True}"/>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="room"/>
                        </group>
                        <group>
                            <field name="weekday"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="school_year_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="start_datetime" invisible="1"/>
                            <field name="stop_datetime" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_timetable_slot_search" model="ir.ui.view">
        <field name="name">school.timetable.slot.search</field>
        <field name="model">school.timetable.slot</field>
        <field name="arch" type="xml">
            <search string="Search Timetable">
                <field name="classroom_id"/>
                <field name="teacher_id"/>
                <field name="subject_id"/>
                <field name="level_id"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Classroom" name="group_classroom" context="{'group_by': 'classroom_id'}"/>
                    <filter string="Day" name="group_weekday" context="{'group_by': 'weekday'}"/>
                    <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Level" name="group_level" context="{'group_by': 'level_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_timetable_slot" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">school.timetable.slot</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Add a lesson to a timetable
            </p>
            <p>
                A lesson links a classroom, a subject and a teacher to a day and a time range.
            </p>
        </field>
    </record>

    <!-- Classroom: smart button, print button and timetable tab -->
    <record id="view_school_classroom_form_timetable" model="ir.ui.view">
        <field name="name">school.classroom.form.timetable</field>
        <field name="model">school.classroom</field>
        <field name="inherit_id" ref="view_school_classroom_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_timetable" type="object"
                        class="oe_stat_button" icon="fa-calendar" invisible="not id">
                    <field name="timetable_slot_count" widget="statinfo" string="Lessons"/>
                </button>
            </div>
            <sheet position="before">
                <header>
                    <button name="action_print_timetable" string="Print Timetable" type="object"
                            class="btn-primary" invisible="not id or not timetable_slot_count"/>
                </header>
            </sheet>
            <page name="students" position="before">
                <page string="Timetable" name="timetable">
                    <field name="timetable_slot_ids">
                        <list editable="bottom">
                            <field name="weekday"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="subject_id" options="{'no_create': True}"/>
                            <field name="teacher_id" options="{'no_create': True}"/>
                            <field name="room"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

    <!-- Teacher: smart button to his own timetable -->
    <record id="view_school_teacher_form_timetable" model="ir.ui.view">
        <field name="name">school.teacher.form.timetable</field>
        <field name="model">school.teacher</field>
        <field name="inherit_id" ref="view_school_teacher_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_timetable" type="object"
                        class="oe_stat_button" icon="fa-calendar" invisible="not id">
                    <field name="timetable_slot_count" widget="statinfo" string="Lessons"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
