<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_year_list" model="ir.ui.view">
        <field name="name">school.year.list</field>
        <field name="model">school.year</field>
        <field name="arch" type="xml">
            <list string="School Years" decoration-muted="state == 'closed'" decoration-bf="is_current">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_year_form" model="ir.ui.view">
        <field name="name">school.year.form</field>
        <field name="model">school.year</field>
        <field name="arch" type="xml">
            <form string="School Year">
                <header>
                    <button name="action_set_current" type="object" string="Set as Current"
                            class="btn-primary" invisible="is_current or state == 'closed'"/>
                    <button name="action_close" type="object" string="Close Year"
                            invisible="state == 'closed'"
                            confirm="Closing the school year cannot be undone by accident. Continue?"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Current" bg_color="text-bg-success" invisible="not is_current"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. 2026-2027"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_current" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_year" model="ir.actions.act_window">
        <field name="name">School Years</field>
        <field name="res_model">school.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Create a school year
            </p>
        </field>
    </record>

</odoo>
