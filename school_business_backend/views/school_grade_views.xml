<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_grade_list" model="ir.ui.view">
        <field name="name">school.grade.list</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list string="Grades" decoration-danger="score_on_20 &lt; 10">
                <field name="date"/>
                <field name="student_id"/>
                <field name="classroom_id" optional="show"/>
                <field name="subject_id"/>
                <field name="period_id"/>
                <field name="evaluation_type"/>
                <field name="score"/>
                <field name="max_score"/>
                <field name="score_on_20"/>
                <field name="academic_year" optional="hide"/>
                <field name="teacher_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form string="Grade">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="classroom_id"/>
                            <field name="subject_id"/>
                            <field name="teacher_id"/>
                        </group>
                        <group>
                            <field name="academic_year"/>
                            <field name="period_id" options="{'no_create': true}"/>
                            <field name="period_type" invisible="1"/>
                            <field name="evaluation_type"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Result">
                            <field name="score"/>
                            <field name="max_score"/>
                            <field name="score_on_20"/>
                        </group>
                        <group string="Comment">
                            <field name="comment" nolabel="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_grade_search" model="ir.ui.view">
        <field name="name">school.grade.search</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <search string="Search Grades">
                <field name="student_id"/>
                <field name="subject_id"/>
                <field name="classroom_id"/>
                <field name="teacher_id"/>
                <field name="period_id"/>
                <filter string="My Grades" name="filter_my" domain="[('teacher_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject_id'}"/>
                    <filter string="Classroom" name="group_classroom" context="{'group_by': 'classroom_id'}"/>
                    <filter string="Period" name="group_period" context="{'group_by': 'period_id'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Record a grade
            </p>
        </field>
    </record>

</odoo>
