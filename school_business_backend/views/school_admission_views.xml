<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_admission_list" model="ir.ui.view">
        <field name="name">school.admission.list</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <list string="Admission Requests" decoration-success="state == 'enrolled'"
                  decoration-danger="state == 'refused'" decoration-muted="state == 'refused'">
                <field name="name"/>
                <field name="student_name"/>
                <field name="level_id"/>
                <field name="parent_name"/>
                <field name="parent_phone"/>
                <field name="application_date"/>
                <field name="responsible_id" optional="show"/>
                <field name="state" widget="badge" decoration-info="state in ('draft','submitted')"
                       decoration-warning="state in ('interview','exam')"
                       decoration-success="state in ('accepted','enrolled')"
                       decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="view_school_admission_kanban" model="ir.ui.view">
        <field name="name">school.admission.kanban</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="student_name"/>
                                        </strong>
                                    </div>
                                    <field name="photo" widget="image" class="o_kanban_image_fill_left"
                                           options="{'size': [32, 32], 'round': true}"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="level_id"/><br/>
                                    <field name="parent_name"/> - <field name="parent_phone"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="application_date"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="responsible_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_school_admission_search" model="ir.ui.view">
        <field name="name">school.admission.search</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <search string="Search Admission Requests">
                <field name="name"/>
                <field name="student_name"/>
                <field name="parent_name"/>
                <field name="parent_phone"/>
                <field name="level_id"/>
                <field name="responsible_id"/>
                <filter string="New" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Application Submitted" name="filter_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Interview" name="filter_interview" domain="[('state', '=', 'interview')]"/>
                <filter string="Entrance Exam" name="filter_exam" domain="[('state', '=', 'exam')]"/>
                <filter string="Accepted" name="filter_accepted" domain="[('state', '=', 'accepted')]"/>
                <filter string="Enrolled" name="filter_enrolled" domain="[('state', '=', 'enrolled')]"/>
                <filter string="Refused" name="filter_refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="My Requests" name="filter_my" domain="[('responsible_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Requested Level" name="group_level" context="{'group_by': 'level_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'responsible_id'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_school_admission_form" model="ir.ui.view">
        <field name="name">school.admission.form</field>
        <field name="model">school.admission</field>
        <field name="arch" type="xml">
            <form string="Admission Request">
                <header>
                    <button name="action_submit" string="Submit Application" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_schedule_interview" string="Schedule Interview" type="object"
                            class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_schedule_exam" string="Schedule Exam" type="object"
                            class="oe_highlight" invisible="state != 'interview'"/>
                    <button name="action_accept" string="Accept" type="object"
                            class="oe_highlight" invisible="state not in ('interview', 'exam')"/>
                    <button name="action_enroll" string="Enroll" type="object"
                            class="oe_highlight" invisible="state != 'accepted'"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state in ('enrolled', 'refused')"/>
                    <button name="action_reset_draft" string="Reset to New" type="object"
                            invisible="state != 'refused'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,interview,exam,accepted,enrolled"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar" readonly="state != 'draft'"/>
                    <div class="oe_title">
                        <label for="student_name"/>
                        <h1>
                            <field name="student_name" placeholder="Student full name" readonly="state != 'draft'"/>
                        </h1>
                        <div class="o_row">
                            <field name="name" readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group string="Student Information">
                            <field name="student_email" readonly="state != 'draft'"/>
                            <field name="date_of_birth" readonly="state != 'draft'"/>
                            <field name="age"/>
                            <field name="place_of_birth" readonly="state != 'draft'"/>
                            <field name="gender" readonly="state != 'draft'"/>
                            <field name="nationality_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="student_id"/>
                        </group>
                        <group string="Admission">
                            <field name="level_id" readonly="state != 'draft'"/>
                            <field name="school_year_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="application_date" readonly="state != 'draft'"/>
                            <field name="responsible_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="street" readonly="state != 'draft'"/>
                            <field name="street2" readonly="state != 'draft'"/>
                            <field name="city" readonly="state != 'draft'"/>
                            <field name="zip" readonly="state != 'draft'"/>
                            <field name="state_id" readonly="state != 'draft'"/>
                            <field name="country_id" readonly="state != 'draft'"/>
                        </group>
                        <group string="Parent / Guardian">
                            <field name="parent_name" readonly="state != 'draft'"/>
                            <field name="parent_relationship" readonly="state != 'draft'"/>
                            <field name="parent_phone" readonly="state != 'draft'"/>
                            <field name="parent_email" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group>
                        <group string="Previous Schooling">
                            <field name="previous_school" readonly="state != 'draft'"/>
                            <field name="previous_level" readonly="state != 'draft'"/>
                        </group>
                        <group string="Interview / Exam" invisible="state in ('draft', 'submitted')">
                            <field name="interview_date"/>
                            <field name="interview_start_time" widget="float_time"/>
                            <field name="interview_end_time" widget="float_time"/>
                            <field name="exam_date"/>
                            <field name="exam_start_time" widget="float_time"/>
                            <field name="exam_end_time" widget="float_time"/>
                            <field name="exam_score"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="application_document" filename="application_document_filename"
                               readonly="state != 'draft'"/>
                        <field name="application_document_filename" invisible="1"/>
                        <div colspan="2" class="text-muted" invisible="state != 'draft'">
                            Required before the application can be submitted.
                        </div>
                    </group>
                    <group string="Refusal Reason" invisible="state != 'refused'">
                        <field name="refusal_reason" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Internal Notes" name="notes">
                            <field name="notes" placeholder="Notes about this file..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_admission" model="ir.actions.act_window">
        <field name="name">Admission Requests</field>
        <field name="res_model">school.admission</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Create a new admission request
            </p>
            <p>
                Track each candidate from the initial application to final enrollment.
            </p>
        </field>
    </record>

</odoo>
