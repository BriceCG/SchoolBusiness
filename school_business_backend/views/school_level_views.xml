<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_level_list" model="ir.ui.view">
        <field name="name">school.level.list</field>
        <field name="model">school.level</field>
        <field name="arch" type="xml">
            <list string="School Levels">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="admission_count" string="Requests"/>
            </list>
        </field>
    </record>

    <record id="view_school_level_form" model="ir.ui.view">
        <field name="name">school.level.form</field>
        <field name="model">school.level</field>
        <field name="arch" type="xml">
            <form string="School Level">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_admissions" type="object"
                                class="oe_stat_button" icon="fa-folder-o">
                            <field name="admission_count" widget="statinfo" string="Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Grade 6"/>
                        </h1>
                    </div>
                    <group>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_level" model="ir.actions.act_window">
        <field name="name">School Levels</field>
        <field name="res_model">school.level</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                Create a school level (e.g. Grade 1, Grade 6, Grade 12...)
            </p>
        </field>
    </record>

</odoo>
