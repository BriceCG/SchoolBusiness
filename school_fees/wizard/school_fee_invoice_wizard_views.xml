<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_fee_invoice_wizard_form" model="ir.ui.view">
        <field name="name">school.fee.invoice.wizard.form</field>
        <field name="model">school.fee.invoice.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Tuition Invoices">
                <p class="text-muted">
                    The invoices are created in draft: review them, then validate them to make
                    them available to the parents.
                </p>
                <group>
                    <field name="school_year_id" options="{'no_create': True}"/>
                    <field name="date_until"/>
                    <field name="level_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    <field name="classroom_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate" string="Generate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_fee_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Generate Tuition Invoices</field>
        <field name="res_model">school.fee.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
