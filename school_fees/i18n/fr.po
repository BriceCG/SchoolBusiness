msgstr ""
"{{ object.company_id.name }} - Rappel de paiement (Facture {{ object.name }})"

#. module: school_fees
#: model:mail.template,body_html:school_fees.mail_template_school_fee_reminder
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Dear <t t-out=\"object.partner_id.name or ''\">Parent</t>,</p>\n"
"    <p>\n"
"        Our records show that invoice <strong t-out=\"object.name or ''\">INV/2026/0001</strong>\n"
"        <t t-if=\"object.student_id\">for <strong t-out=\"object.student_id.name\"/></t>\n"
"        is still unpaid. It was due on <t t-out=\"object.invoice_date_due or ''\">2026-01-01</t>\n"
"        (<t t-out=\"object.school_days_overdue\">5</t> days ago).\n"
"    </p>\n"
"    <p>\n"
"        Amount due:\n"
"        <strong t-out=\"object.amount_residual\" t-options=\"{'widget': 'monetary', 'display_currency': object.currency_id}\">100.00</strong>\n"
"    </p>\n"
"    <p>\n"
"        Reminder <t t-out=\"object.school_reminder_count + 1\">1</t> of <t t-out=\"object.school_reminder_max\">3</t>.\n"
"        If you have already paid, please ignore this message.\n"
"    </p>\n"
"    <p>Thank you,<br/><t t-out=\"object.company_id.name or ''\">School</t></p>\n"
"</div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"    <p>Bonjour <t t-out=\"object.partner_id.name or ''\">Parent</t>,</p>\n"
"    <p>\n"
"        Selon nos dossiers, la facture <strong t-out=\"object.name or ''\">INV/2026/0001</strong>\n"
"        <t t-if=\"object.student_id\">de <strong t-out=\"object.student_id.name\"/></t>\n"
"        est toujours impayée. Elle était due le <t t-out=\"object.invoice_date_due or ''\">2026-01-01</t>\n"
"        (il y a <t t-out=\"object.school_days_overdue\">5</t> jours).\n"
"    </p>\n"
"    <p>\n"
"        Montant dû :\n"
