<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_school_fee_invoices" model="ir.actions.act_window">
        <field name="name">Tuition Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_type', '=', 'out_invoice'), ('student_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                No tuition invoice yet
            </p>
            <p>
                Define the tuition fees on the school levels, then generate the invoices.
            </p>
        </field>
    </record>

    <menuitem id="menu_school_fees"
              name="Tuition"
              parent="school_business_backend.menu_school_root"
              sequence="40"/>

    <menuitem id="menu_school_fee_invoices"
              name="Invoices"
              parent="menu_school_fees"
              action="action_school_fee_invoices"
              sequence="10"/>

    <menuitem id="menu_school_fee_generate"
              name="Generate Invoices"
              parent="menu_school_fees"
              action="action_school_fee_invoice_wizard"
              groups="school_business_backend.group_school_admission_manager"
              sequence="20"/>

</odoo>
