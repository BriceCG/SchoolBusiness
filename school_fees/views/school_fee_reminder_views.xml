<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_list_school_reminder" model="ir.ui.view">
        <field name="name">account.move.list.school.reminder</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Overdue Reminders" create="0" delete="0" edit="0"
                  decoration-danger="school_days_overdue &gt; 30">
                <header>
                    <button name="action_send_all_school_reminders" type="object"
                            string="Send All" display="always" class="btn-primary"
                            confirm="Send the reminder of all the invoices of the list?"/>
                </header>
                <field name="name"/>
                <field name="student_id"/>
                <field name="partner_id" string="Payer"/>
                <field name="school_partner_email" optional="show"/>
                <field name="invoice_date_due"/>
                <field name="school_days_overdue"/>
                <field name="amount_residual" sum="Total"/>
                <field name="school_reminder_count"/>
                <field name="school_reminder_max"/>
                <field name="school_reminder_last_date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_send_school_reminder" type="object" string="Send"
                        icon="fa-envelope" title="Send the reminder"/>
            </list>
        </field>
    </record>

    <record id="view_move_search_school_reminder" model="ir.ui.view">
        <field name="name">account.move.search.school.reminder</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="partner_id" string="Payer"/>
                <group expand="0" string="Group By">
                    <filter name="group_payer" string="Payer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_student" string="Student" context="{'group_by': 'student_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_fee_reminders" model="ir.actions.act_window">
        <field name="name">Overdue Reminders</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('school_reminder_due', '=', True)]</field>
        <field name="search_view_id" ref="view_move_search_school_reminder"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_move_list_school_reminder')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_help">
                No invoice to remind
            </p>
            <p>
                Enable the overdue reminders in the settings to list the unpaid tuition invoices.
            </p>
        </field>
    </record>

    <menuitem id="menu_school_fee_reminders"
              name="Tuition Reminders"
              parent="menu_school_fees"
              action="action_school_fee_reminders"
              sequence="30"/>

</odoo>
