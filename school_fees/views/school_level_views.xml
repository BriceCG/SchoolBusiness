<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_school_level_form_fees" model="ir.ui.view">
        <field name="name">school.level.form.fees</field>
        <field name="model">school.level</field>
        <field name="inherit_id" ref="school_business_backend.view_school_level_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Tuition Fees" name="fees">
                        <field name="fee_line_ids">
                            <list editable="bottom">
                                <field name="school_year_id" options="{'no_create': True}"/>
                                <field name="amount"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="company_id" column_invisible="1"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

</odoo>
