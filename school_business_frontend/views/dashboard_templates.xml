<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Access denied: the user is not a student -->
    <template id="student_dashboard_forbidden" name="Student Dashboard - Access Denied">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <div class="container py-5 text-center">
                    <i class="fa fa-lock fa-4x text-muted mb-3"/>
                    <h1>Access restricted</h1>
                    <p class="lead text-muted">
                        This page is reserved for enrolled students.
                    </p>
                    <a href="/" class="btn btn-primary">Back to Home</a>
                </div>
            </div>
        </t>
    </template>

    <!-- Lesson of the moment: current lesson, else the next one -->
    <template id="student_current_lesson" name="Student Current Lesson">
        <div class="sd-lesson rounded-4 p-4 mb-4">
            <t t-if="current_lesson">
                <div class="d-flex flex-column flex-md-row align-items-md-center gap-3 gap-md-4">
                    <div class="sd-lesson-icon"><i class="fa fa-book"/></div>
                    <div class="flex-grow-1">
                        <div class="mb-1">
                            <span t-if="current_lesson['status'] == 'now'" class="badge rounded-pill text-bg-success">
                                <i class="fa fa-circle me-1 small"/>In progress
                            </span>
                            <span t-else="" class="badge rounded-pill text-bg-warning">Next lesson</span>
                            <span class="small text-muted ms-2">
                                <t t-out="current_lesson['day']"/> ·
                                <t t-out="current_lesson['start']"/> - <t t-out="current_lesson['end']"/>
                            </span>
                        </div>
                        <h2 class="h3 fw-bold mb-2" t-out="current_lesson['slot'].subject_id.name"/>
                        <div class="d-flex flex-wrap gap-3 text-muted">
                            <span t-if="current_lesson['slot'].teacher_id">
                                <i class="fa fa-user-circle-o me-1"/><t t-out="current_lesson['slot'].teacher_id.name"/>
                            </span>
                            <span t-if="current_lesson['room']">
                                <i class="fa fa-map-marker me-1"/><t t-out="current_lesson['room']"/>
                            </span>
                            <span>
                                <i class="fa fa-clock-o me-1"/><t t-out="current_lesson['duration']"/>
                            </span>
                        </div>
                        <div t-if="current_lesson['status'] == 'now'" class="mt-3">
                            <div class="progress sd-progress">
                                <div class="progress-bar bg-success" role="progressbar"
                                     t-attf-style="width: #{current_lesson['progress']}%"/>
                            </div>
                            <div class="small text-muted mt-1">
                                <t t-out="current_lesson['remaining']"/> remaining
                            </div>
                        </div>
                    </div>
                    <button t-if="week_timetable" type="button" class="sd-lesson-toggle collapsed"
                            data-bs-toggle="collapse" data-bs-target="#sd_week_timetable"
                            aria-expanded="false" aria-controls="sd_week_timetable"
                            title="Weekly timetable">
                        <i class="fa fa-chevron-down"/>
                    </button>
                </div>
            </t>
            <div t-else="" class="d-flex align-items-center gap-3 text-muted">
                <div class="sd-lesson-icon sd-lesson-icon-empty"><i class="fa fa-calendar-o"/></div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">No lesson planned</div>
                    <div class="small">Your timetable has no upcoming lesson.</div>
                </div>
                <button t-if="week_timetable" type="button" class="sd-lesson-toggle collapsed"
                        data-bs-toggle="collapse" data-bs-target="#sd_week_timetable"
                        aria-expanded="false" aria-controls="sd_week_timetable"
                        title="Weekly timetable">
                    <i class="fa fa-chevron-down"/>
                </button>
            </div>

            <!-- Weekly timetable, shown with the arrow -->
            <div t-if="week_timetable" id="sd_week_timetable" class="collapse mt-4">
                <h3 class="h6 fw-bold text-uppercase text-muted mb-3">
                    <i class="fa fa-calendar me-1"/>My timetable of the week
                </h3>
                <div class="row g-3">
                    <div t-foreach="week_timetable" t-as="day" class="col-md-6 col-xl-4">
                        <div t-attf-class="sd-day h-100 #{day['is_today'] and 'sd-day-today' or ''}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold" t-out="day['label']"/>
                                <span t-if="day['is_today']" class="badge rounded-pill text-bg-primary">Today</span>
                            </div>
                            <div t-foreach="day['lessons']" t-as="lesson"
                                 t-attf-class="sd-day-lesson #{lesson['is_now'] and 'sd-day-lesson-now' or ''}">
                                <div class="sd-day-time">
                                    <t t-out="lesson['start']"/><br/>
                                    <span class="text-muted"><t t-out="lesson['end']"/></span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold" t-out="lesson['slot'].subject_id.name"/>
                                    <div class="small text-muted">
                                        <span t-if="lesson['slot'].teacher_id">
                                            <t t-out="lesson['slot'].teacher_id.name"/> ·
                                        </span>
                                        <span t-if="lesson['room']"><t t-out="lesson['room']"/> · </span>
                                        <t t-out="lesson['duration']"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Student home: replaces "My Account" for students (grades and invoices) -->
    <template id="student_home" name="Student Home">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure school-dashboard">
                <div class="container py-4 py-lg-5">

                    <div class="sd-hero rounded-4 p-4 p-lg-5 mb-4">
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                            <img t-if="student.photo" class="sd-avatar"
                                 t-att-src="image_data_uri(student.photo)" alt="Photo"/>
                            <div t-else="" class="sd-avatar sd-avatar-empty"><i class="fa fa-user"/></div>
                            <div class="flex-grow-1">
                                <div class="text-uppercase small opacity-75 mb-1">Welcome back</div>
                                <h1 class="h2 fw-bold mb-2" t-out="student.name"/>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="sd-chip"><i class="fa fa-id-card-o me-1"/><t t-out="student.matricule"/></span>
                                    <span class="sd-chip" t-if="student.level_id"><i class="fa fa-graduation-cap me-1"/><t t-out="student.level_id.name"/></span>
                                    <span class="sd-chip" t-if="student.classroom_id"><i class="fa fa-users me-1"/><t t-out="student.classroom_id.name"/></span>
                                    <span class="sd-chip"><i class="fa fa-calendar me-1"/><t t-out="student.academic_year"/></span>
                                </div>
                            </div>
                            <div class="d-flex gap-2 flex-md-column">
                                <a href="/my/account" class="btn btn-light btn-sm"><i class="fa fa-cog me-1"/>My details</a>
                                <a href="/my/security" class="btn btn-outline-light btn-sm"><i class="fa fa-shield me-1"/>Security</a>
                            </div>
                        </div>
                    </div>

                    <t t-call="school_business_frontend.student_current_lesson"/>

                    <!-- KPIs -->
                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <a href="/my/student" class="sd-card sd-link d-block h-100 text-decoration-none text-reset">
                                <div class="sd-card-icon bg-primary-subtle text-primary"><i class="fa fa-line-chart"/></div>
                                <div class="sd-card-value" t-out="'%.2f' % average"/>
                                <div class="text-muted small">Average of the year (/20)</div>
                            </a>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="sd-card h-100">
                                <div t-attf-class="sd-card-icon #{amount_due and 'bg-danger-subtle text-danger' or 'bg-success-subtle text-success'}">
                                    <i t-attf-class="fa #{amount_due and 'fa-credit-card' or 'fa-check'}"/>
                                </div>
                                <div class="sd-card-value" t-out="amount_due" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                <div class="text-muted small">Amount to pay</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-4">
                            <div class="sd-card h-100">
                                <div class="sd-card-icon bg-warning-subtle text-warning"><i class="fa fa-clock-o"/></div>
                                <div class="sd-card-value" t-if="next_due" t-out="next_due" t-options="{'widget': 'date'}"/>
                                <div class="sd-card-value" t-else="">-</div>
                                <div class="text-muted small">
                                    Next due date
                                    <span t-if="overdue_count" class="badge text-bg-danger ms-1"><t t-out="overdue_count"/> overdue</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Grades -->
                        <div class="col-lg-6">
                            <div class="sd-card h-100">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h2 class="h5 fw-bold mb-0"><i class="fa fa-graduation-cap text-primary me-2"/>My grades</h2>
                                    <a href="/my/student" class="small fw-semibold text-decoration-none">See all <i class="fa fa-arrow-right"/></a>
                                </div>
                                <div t-if="not recent_grades" class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x mb-2"/>
                                    <p class="mb-0">No grades yet.</p>
                                </div>
                                <div t-foreach="recent_grades" t-as="g" class="sd-row">
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold" t-out="g.subject_id.name"/>
                                        <div class="small text-muted" t-out="g.date" t-options="{'widget': 'date'}"/>
                                    </div>
                                    <span t-attf-class="badge rounded-pill fs-6 text-bg-#{g.score_on_20 &gt;= 14 and 'success' or (g.score_on_20 &gt;= 10 and 'warning' or 'danger')}">
                                        <t t-out="'%g' % g.score"/> / <t t-out="'%g' % g.max_score"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Invoices -->
                        <div class="col-lg-6">
                            <div class="sd-card h-100">
                                <h2 class="h5 fw-bold mb-3"><i class="fa fa-file-text-o text-primary me-2"/>My invoices</h2>
                                <div t-if="not invoice_rows" class="text-center text-muted py-4">
                                    <i class="fa fa-inbox fa-2x mb-2"/>
                                    <p class="mb-0">No invoices yet.</p>
                                </div>
                                <div t-foreach="invoice_rows" t-as="row" class="sd-row">
                                    <div class="flex-grow-1">
                                        <a t-att-href="row['view_url']" class="fw-semibold text-decoration-none" t-out="row['invoice'].name"/>
                                        <div class="small text-muted">
                                            Due <t t-out="row['invoice'].invoice_date_due" t-options="{'widget': 'date'}"/>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold" t-out="row['invoice'].amount_total"
                                             t-options="{'widget': 'monetary', 'display_currency': row['invoice'].currency_id}"/>
                                        <span t-if="not row['unpaid']" class="badge rounded-pill text-bg-success">Paid</span>
                                        <span t-elif="row['overdue']" class="badge rounded-pill text-bg-danger">Overdue</span>
                                        <span t-elif="row['invoice'].payment_state == 'partial'" class="badge rounded-pill text-bg-warning">Partially paid</span>
                                        <span t-else="" class="badge rounded-pill text-bg-warning">To pay</span>
                                    </div>
                                    <a t-att-href="row['pdf_url']" class="btn btn-light btn-sm ms-2" title="Download">
                                        <i class="fa fa-download"/>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

    <!-- Student dashboard -->
    <template id="student_dashboard" name="Student Dashboard">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure school-dashboard">
                <div class="container py-4 py-lg-5">

                    <!-- Hero -->
                    <div class="sd-hero rounded-4 p-4 p-lg-5 mb-4">
                        <div class="d-flex flex-column flex-md-row align-items-md-center gap-4">
                            <img t-if="student.photo" class="sd-avatar"
                                 t-att-src="image_data_uri(student.photo)" alt="Photo"/>
                            <div t-else="" class="sd-avatar sd-avatar-empty">
                                <i class="fa fa-user"/>
                            </div>
                            <div class="flex-grow-1">
                                <div class="text-uppercase small opacity-75 mb-1">Student space</div>
                                <h1 class="h2 fw-bold mb-2" t-out="student.name"/>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="sd-chip"><i class="fa fa-id-card-o me-1"/><t t-out="student.matricule"/></span>
                                    <span class="sd-chip" t-if="student.level_id"><i class="fa fa-graduation-cap me-1"/><t t-out="student.level_id.name"/></span>
                                    <span class="sd-chip" t-if="student.classroom_id"><i class="fa fa-users me-1"/><t t-out="student.classroom_id.name"/></span>
                                    <span class="sd-chip"><i class="fa fa-calendar me-1"/><t t-out="student.academic_year"/></span>
                                </div>
                            </div>
                            <div class="sd-score text-center">
                                <div class="sd-score-value" t-out="'%.2f' % overall"/>
                                <div class="small opacity-75">Average / 20</div>
                            </div>
                        </div>
                    </div>

                    <t t-call="school_business_frontend.student_current_lesson"/>

                    <!-- Filters -->
                    <form method="get" action="/my/student" class="row g-2 align-items-end mb-4">
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted mb-1" for="sd_year">Academic year</label>
                            <select id="sd_year" name="year" class="form-select" onchange="this.form.submit()">
                                <t t-foreach="years" t-as="y">
                                    <option t-att-value="y" t-att-selected="y == selected_year" t-out="y"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small text-muted mb-1" for="sd_period">Period</label>
                            <select id="sd_period" name="period" class="form-select" onchange="this.form.submit()">
                                <option value="">All periods</option>
                                <t t-foreach="periods" t-as="p">
                                    <option t-att-value="p.id" t-att-selected="p.id == selected_period" t-out="p.name"/>
                                </t>
                            </select>
                        </div>
                    </form>

                    <!-- KPI cards -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-lg-3">
                            <div class="sd-card h-100">
                                <div class="sd-card-icon bg-primary-subtle text-primary"><i class="fa fa-line-chart"/></div>
                                <div class="sd-card-value" t-out="'%.2f' % overall"/>
                                <div class="text-muted small">Overall average (/20)</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="sd-card h-100">
                                <div class="sd-card-icon bg-success-subtle text-success"><i class="fa fa-trophy"/></div>
                                <div class="sd-card-value text-truncate" t-out="best_subject and best_subject['subject'].name or '-'"/>
                                <div class="text-muted small">Best subject</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="sd-card h-100">
                                <div class="sd-card-icon bg-info-subtle text-info"><i class="fa fa-book"/></div>
                                <div class="sd-card-value" t-out="len(subjects)"/>
                                <div class="text-muted small">Subjects evaluated</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="sd-card h-100">
                                <div class="sd-card-icon bg-warning-subtle text-warning"><i class="fa fa-pencil-square-o"/></div>
                                <div class="sd-card-value" t-out="len(grades)"/>
                                <div class="text-muted small">Evaluations</div>
                            </div>
                        </div>
                    </div>

                    <div t-if="not grades" class="sd-card text-center py-5 text-muted">
                        <i class="fa fa-inbox fa-3x mb-3"/>
                        <p class="mb-0">No grades available for this selection yet.</p>
                    </div>

                    <div t-else="" class="row g-4">
                        <!-- Subjects -->
                        <div class="col-lg-5">
                            <div class="sd-card h-100">
                                <h2 class="h5 fw-bold mb-4">Averages by subject</h2>
                                <div t-foreach="subjects" t-as="s" class="mb-3">
                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                        <span class="fw-semibold" t-out="s['subject'].name"/>
                                        <span t-attf-class="fw-bold text-#{s['color']}" t-out="'%.2f' % s['average']"/>
                                    </div>
                                    <div class="progress sd-progress">
                                        <div t-attf-class="progress-bar bg-#{s['color']}" role="progressbar"
                                             t-attf-style="width: #{min(s['average'] * 5, 100)}%"/>
                                    </div>
                                    <div class="text-muted small mt-1">
                                        Coef. <t t-out="'%g' % s['coefficient']"/> ·
                                        <t t-out="s['count']"/> evaluation(s)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Grades table -->
                        <div class="col-lg-7">
                            <div class="sd-card h-100">
                                <h2 class="h5 fw-bold mb-3">Latest grades</h2>
                                <div class="table-responsive">
                                    <table class="table align-middle sd-table mb-0">
                                        <thead>
                                            <tr class="text-muted small text-uppercase">
                                                <th>Date</th>
                                                <th>Subject</th>
                                                <th>Type</th>
                                                <th class="text-end">Grade</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="grades" t-as="g">
                                                <td class="text-nowrap text-muted" t-out="g.date" t-options="{'widget': 'date'}"/>
                                                <td>
                                                    <div class="fw-semibold" t-out="g.subject_id.name"/>
                                                    <div class="small text-muted" t-if="g.comment" t-out="g.comment"/>
                                                </td>
                                                <td>
                                                    <span class="badge rounded-pill text-bg-light border"
                                                          t-out="evaluation_labels.get(g.evaluation_type)"/>
                                                </td>
                                                <td class="text-end text-nowrap">
                                                    <span t-attf-class="badge rounded-pill fs-6 text-bg-#{g.score_on_20 &gt;= 14 and 'success' or (g.score_on_20 &gt;= 10 and 'warning' or 'danger')}">
                                                        <t t-out="'%g' % g.score"/> / <t t-out="'%g' % g.max_score"/>
                                                    </span>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>

</odoo>
